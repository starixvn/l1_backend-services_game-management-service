    "components": {
        "schemas": {
            "UpdateBotsOutRoomRequest": {
                "type": "object",
                "properties": { "botIds": { "type": "array", "items": { "type": "string" } } },
                "required": ["botIds"]
            },
            "UpdateBotsJoinRoomRequest": {
                "type": "object",
                "properties": { "botIds": { "type": "array", "items": { "type": "string" } }, "gameName": { "type": "string" } },
                "required": ["botIds", "gameName"]
            },
            "ResetBotInRoomRequest": { "type": "object", "properties": { "gameName": { "type": "string" } }, "required": ["gameName"] },
            "UpdateStakeLevelRequest": {
                "type": "object",
                "properties": { "id": { "type": "string" }, "minBet": { "type": "number" }, "maxBet": { "type": "number" } },
                "required": ["id", "minBet", "maxBet"]
            },
            "CreatePoolRequest": {
                "type": "object",
                "properties": {
                    "gameId": { "type": "number" },
                    "pool": { "type": "number" },
                    "roundId": { "type": "number" },
                    "gameName": { "type": "string" },
                    "amount": { "type": "number" },
                    "initAmount": { "type": "number" }
                },
                "required": ["gameId", "pool", "roundId", "gameName", "amount", "initAmount"]
            },
            "ContributeJackpotRequest": {
                "type": "object",
                "properties": {
                    "gameId": { "type": "number" },
                    "pool": { "type": "number" },
                    "roundId": { "type": "number" },
                    "amount": { "type": "number" },
                    "byBots": { "type": "number" },
                    "byMembers": { "type": "number" }
                },
                "required": ["gameId", "pool", "roundId", "amount", "byBots", "byMembers"]
            },
            "HitJackpotRequest": {
                "type": "object",
                "properties": {
                    "gameId": { "type": "number" },
                    "pool": { "type": "number" },
                    "roundId": { "type": "number" },
                    "winningRatio": { "type": "number" },
                    "winnerName": { "type": "string" },
                    "winnerId": { "type": "number" },
                    "rate": { "type": "number" },
                    "exchangeRateId": { "type": "number" },
                    "operatorId": { "type": "string" },
                    "currency": { "type": "string" }
                },
                "required": [
                    "gameId",
                    "pool",
                    "roundId",
                    "winningRatio",
                    "winnerName",
                    "winnerId",
                    "rate",
                    "exchangeRateId",
                    "operatorId",
                    "currency"
                ]
            },
            "IncreaseIdCounterRequest": {
                "type": "object",
                "properties": { "gameName": { "type": "string" }, "modelName": { "type": "string" } },
                "required": ["gameName", "modelName"]
            },
            "UpdateLatestIdCounterRequest": {
                "type": "object",
                "properties": { "gameName": { "type": "string" }, "modelName": { "type": "string" }, "id": { "type": "number" } },
                "required": ["gameName", "modelName", "id"]
            }
        }
